[Unit]
Description=Nexora nightly jobs (analytics refresh, retention, backup)

[Service]
Type=oneshot
User=nexora
WorkingDirectory=/opt/nexora/apps/api
EnvironmentFile=/etc/nexora/api.env
ExecStart=/usr/bin/node dist/scripts/analytics-refresh.js
ExecStart=/usr/bin/node dist/scripts/retention.js
ExecStart=/opt/nexora/infra/backup/backup.sh
