# Alternative to Docker: run the API directly on a Linux server.
# Install: cp nexora-api.service /etc/systemd/system/ && systemctl enable --now nexora-api
[Unit]
Description=Nexora API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=nexora
WorkingDirectory=/opt/nexora/apps/api
EnvironmentFile=/etc/nexora/api.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/nexora

[Install]
WantedBy=multi-user.target
