{
  "name": "@nexora/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && tsx --env-file-if-exists=.env src/scripts/analytics-setup.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "analytics:refresh": "tsx --env-file-if-exists=.env src/scripts/analytics-refresh.ts",
    "retention": "tsx --env-file-if-exists=.env src/scripts/retention.ts",
    "ldap:dev": "tsx --env-file-if-exists=.env src/scripts/dev-ldap.ts",
    "mongo:dev": "tsx src/scripts/dev-mongo.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "e2e:server": "tsx test/e2e-server.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "mongoose": "^9.11.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "ldapjs": "^3.0.7",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
