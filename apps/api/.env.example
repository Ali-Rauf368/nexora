NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://nexora@localhost:5434/nexora
MONGO_URL=mongodb://127.0.0.1:27018/nexora
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5190
INGEST_API_KEY=dev-ingest-key-change-me-0123456789

# Active Directory / LDAP (defaults point to the bundled mock directory on :3890)
LDAP_URL=ldap://localhost:3890
LDAP_BIND_DN=CN=svc-nexora,OU=Service Accounts,DC=rheinwerk,DC=local
LDAP_BIND_PASSWORD=svc-password
LDAP_BASE_DN=OU=Users,DC=rheinwerk,DC=local
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
LDAP_GROUP_ROLE_MAP=CN=Nexora-Admins,OU=Groups,DC=rheinwerk,DC=local=ADMIN;CN=Nexora-HR,OU=Groups,DC=rheinwerk,DC=local=HR;CN=Nexora-Sales,OU=Groups,DC=rheinwerk,DC=local=SALES;CN=Nexora-AfterSales,OU=Groups,DC=rheinwerk,DC=local=AFTERSALES;CN=Nexora-Accounting,OU=Groups,DC=rheinwerk,DC=local=ACCOUNTING;CN=Nexora-Managers,OU=Groups,DC=rheinwerk,DC=local=MANAGER

# GDPR retention
AUDIT_RETENTION_DAYS=400
LEAVE_RETENTION_YEARS=3
