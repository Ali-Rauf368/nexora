// Clinical and billing data of Nexora Clinic. The access log lives in MongoDB (src/db/mongo.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTION
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role
  /// Only set for doctors, e.g. "General Practice".
  specialty    String?
  /// Colour used for this doctor's column in the schedule.
  color        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Patient {
  id                String        @id @default(uuid())
  /// Medical record number shown to staff, e.g. "MRN-001042".
  mrn               String        @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime      @db.Date
  sex               Sex
  phone             String
  email             String?
  address           String?
  bloodType         String?
  allergies         String?
  insuranceProvider String?
  insuranceNumber   String?
  createdAt         DateTime      @default(now())
  appointments      Appointment[]
  invoices          Invoice[]

  @@index([lastName, firstName])
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       User              @relation(fields: [doctorId], references: [id])
  startsAt     DateTime
  durationMin  Int               @default(20)
  reason       String
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  consultation Consultation?
  invoice      Invoice?

  @@index([doctorId, startsAt])
  @@index([startsAt])
}

/// What the doctor recorded during a completed appointment.
model Consultation {
  id            String         @id @default(uuid())
  appointmentId String         @unique
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  diagnosis     String
  notes         String?
  bpSystolic    Int?
  bpDiastolic   Int?
  pulse         Int?
  temperatureC  Decimal?       @db.Decimal(4, 1)
  weightKg      Decimal?       @db.Decimal(5, 1)
  createdAt     DateTime       @default(now())
  prescriptions Prescription[]
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medication     String
  dosage         String
  frequency      String
  days           Int
}

model Invoice {
  id            String        @id @default(uuid())
  /// Human-readable number, e.g. "INV-2026-00017".
  number        String        @unique
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]

  @@index([status])
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
}
